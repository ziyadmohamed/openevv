# Ukrainian iotated-vowel expansion, run inside normalisation.
#
# я and ю are iotated -- /ja/ and /ju/ -- but there is no free latin-1 byte
# that reaches the letter-to-sound own-arm as its own letter: Italian's chain
# folds every accented latin-1 vowel to a bare nucleus (ae->a, u-grave->u), and
# the two are parked on ae/u-grave, so left to themselves they would speak the
# vowel with no /j/ onset. Rather than route the single letter, this rewrites
# it, here in normalisation and before the fold can reach it, into the two
# INPUT letters that already speak: я -> й,а and ю -> й,у. The own-arm then
# voices й (/j/) and the vowel in turn, which is /ja/ and /ju/.
#
# Modelled on apply_pol_letter_rules (it_phone.up): the two ends of the current
# letter arrive as arg 1 (left) and arg 2 (right); the scan is set from the
# left one, the letter is asked about, and its two-letter replacement is laid
# between the two points. It answers 0 when it rewrote the letter and 1 when
# the letter was neither я nor ю, so normalize_ital_letters can fall through to
# the ordinary fold on a 1. The two letters tested are the parked codes the
# input carries: ukua_let_ju (0x65, ю on u-grave) and ukua_let_ja (0x8f, я on
# ae); the two laid down are ukua_exp_ju / ukua_exp_ja, one alphabet index per
# character.
rule ukua_expand_iotated takes 3 from it_norm.obj
  local left bytes 8
  local right bytes 8
  call ZZget_parm_ptr2 addr left arg 1 addr right arg 2
  call ZZfence_null

  call ZZlpta_load__setscan_r__1 addr left
  if answer is not 0
    give up
  end

  call test_string_s 1 1 sym ukua_let_ju
  if answer is 0
    call lpta_rpta_loadp addr left addr right
    call insert_2pt_s 2 2 sym ukua_exp_ju 0
    if answer is 0
      answer 0
    end
  end
  call ZZlpta_load__setscan_r__1 addr left
  call test_string_s 1 1 sym ukua_let_ja
  if answer is 0
    call lpta_rpta_loadp addr left addr right
    call insert_2pt_s 2 2 sym ukua_exp_ja 0
    if answer is 0
      answer 0
    end
  end
  answer 1
end
