bytes pol_ph_x            24

# --- Ukrainian ---------------------------------------------------------------
# The thirty-three Cyrillic letters. Italian's letter-to-sound chain tests each
# letter against a Latin code and calls that letter's rule; no Cyrillic letter
# matches any of those, so every one falls through to the link Polish repointed
# at pol_test_own_letters and apply_pol_letter_rules, which is where ukua speaks
# them. The code each letter carries is the input alphabet's -- the index
# tools/module/alphabet.py show ukua gives it, not the byte the codepoints table
# maps to -- because that index is what the machine hands the rules and what
# test_string_s compares. Each Cyrillic byte 0xC0-0xE1 lands on an accented-Latin
# slot whose Latin-1 name sits at a scattered index, so these are not contiguous.
bytes ukua_let_a          66      # а  (byte c0, slot À)
bytes ukua_let_b          70      # б  (c1, Á)
